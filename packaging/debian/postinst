#!/bin/sh
set -e

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database /usr/share/applications || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -q /usr/share/icons/hicolor || true
fi

pin_for_user() {
  user_name="$1"
  user_id="$(id -u "$user_name" 2>/dev/null || true)"
  [ -n "$user_id" ] || return 0
  command -v gsettings >/dev/null 2>&1 || return 0

  bus="unix:path=/run/user/$user_id/bus"
  current="$(sudo -u "$user_name" DBUS_SESSION_BUS_ADDRESS="$bus" XDG_RUNTIME_DIR="/run/user/$user_id" \
    gsettings get org.cinnamon favorite-apps 2>/dev/null || true)"

  [ -n "$current" ] || return 0
  echo "$current" | grep -q "codex-plusplus-linux.desktop" && return 0

  updated="$(printf '%s' "$current" | sed "s/]$/, 'codex-plusplus-linux.desktop']/")"
  sudo -u "$user_name" DBUS_SESSION_BUS_ADDRESS="$bus" XDG_RUNTIME_DIR="/run/user/$user_id" \
    gsettings set org.cinnamon favorite-apps "$updated" 2>/dev/null || true
}

if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
  pin_for_user "$SUDO_USER"
  user_id="$(id -u "$SUDO_USER" 2>/dev/null || true)"
  if [ -n "$user_id" ] && command -v systemctl >/dev/null 2>&1; then
    sudo -u "$SUDO_USER" XDG_RUNTIME_DIR="/run/user/$user_id" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$user_id/bus" \
      systemctl --user daemon-reload 2>/dev/null || true
    sudo -u "$SUDO_USER" XDG_RUNTIME_DIR="/run/user/$user_id" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$user_id/bus" \
      systemctl --user enable --now codex-plusplus-linux-daemon.service 2>/dev/null || true
  fi
  sudo -u "$SUDO_USER" /opt/codex-plusplus-linux/integrations/nemo/install.sh >/dev/null 2>&1 || true
fi

exit 0
